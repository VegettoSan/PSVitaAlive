#pragma once

#include <cstdint>
#include <string>
#include <vector>

namespace psvitaalive {
namespace ui {

enum class CatalogType {
    Homebrew = 0,
    VitaGames,
    PspGames,
    Ps1Games,
    Count
};

const char* catalogName(CatalogType t);

struct CatalogItem {
    std::string id;
    std::string name;
    std::string author;
    std::string status;   // Verified / Legacy / Archive
    std::string version;
};

struct UiState {
    CatalogType catalog = CatalogType::Homebrew;
    int focusIndex = 0;          // linear index into current list
    int scrollRow = 0;           // first visible row
    bool requestExit = false;
};

constexpr int SCREEN_W = 960;
constexpr int SCREEN_H = 544;
constexpr int GRID_COLS = 3;
constexpr int HEADER_H = 52;
constexpr int TABS_H = 36;
constexpr int FOOTER_H = 40;
constexpr int GRID_PAD = 12;
constexpr int CARD_GAP = 10;

} // namespace ui
} // namespace psvitaalive
