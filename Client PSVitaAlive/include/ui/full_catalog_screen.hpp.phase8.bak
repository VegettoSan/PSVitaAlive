#pragma once

#include "ui/ui_types.hpp"

#include <vita2d.h>
#include <string>
#include <vector>

namespace psvitaalive {
namespace ui {

/**
 * FULL_CATALOG — Phase 8
 * 3-column grid, L/R catalog switch, D-Pad focus, footer hints.
 * Uses mock data until catalog loader arrives.
 */
class FullCatalogScreen {
public:
    FullCatalogScreen();
    ~FullCatalogScreen();

    bool init();
    void shutdown();

    /** Pump one frame: input + draw. Returns false if exit requested. */
    bool updateAndDraw();

private:
    UiState state_;
    std::vector<CatalogItem> items_;
    vita2d_pgf* font_ = nullptr;
    bool ready_ = false;

    void loadMockData();
    void handleInput();
    void draw();
    void clampFocus();

    int visibleRows() const;
    int totalRows() const;
};

} // namespace ui
} // namespace psvitaalive
