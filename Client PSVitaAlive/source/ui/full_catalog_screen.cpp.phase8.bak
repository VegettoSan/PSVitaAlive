#include "ui/full_catalog_screen.hpp"

#include <psp2/ctrl.h>
#include <psp2/kernel/clib.h>
#include <psp2/touch.h>

#include <algorithm>
#include <cstring>

namespace psvitaalive {
namespace ui {

namespace {
constexpr unsigned BG       = RGBA8(0x00, 0x00, 0x00, 0xFF);
constexpr unsigned SURFACE  = RGBA8(0x37, 0x37, 0x37, 0xFF);
constexpr unsigned SURFACE2 = RGBA8(0x2a, 0x2a, 0x2a, 0xFF);
constexpr unsigned BORDER   = RGBA8(0x6e, 0x6e, 0x6e, 0xFF);
constexpr unsigned TEXT     = RGBA8(0xaa, 0xaa, 0xaa, 0xFF);
constexpr unsigned TEXT_DIM = RGBA8(0x6e, 0x6e, 0x6e, 0xFF);
constexpr unsigned ACCENT   = RGBA8(0x3b, 0xff, 0x00, 0xFF);
constexpr unsigned WHITE    = RGBA8(0xff, 0xff, 0xff, 0xFF);
}

FullCatalogScreen::FullCatalogScreen() = default;

FullCatalogScreen::~FullCatalogScreen() {
    shutdown();
}

bool FullCatalogScreen::init() {
    vita2d_init();
    vita2d_set_clear_color(BG);
    font_ = vita2d_load_default_pgf();
    if (!font_) {
        sceClibPrintf("[UI] failed to load pgf font\n");
        return false;
    }
    sceCtrlSetSamplingMode(SCE_CTRL_MODE_ANALOG);
    loadMockData();
    ready_ = true;
    return true;
}

void FullCatalogScreen::shutdown() {
    if (font_) {
        vita2d_free_pgf(font_);
        font_ = nullptr;
    }
    if (ready_) {
        vita2d_fini();
        ready_ = false;
    }
}

void FullCatalogScreen::loadMockData() {
    items_.clear();
    // Placeholder cards until catalog.json loader exists
    const char* names[] = {
        "VitaShell", "Adrenaline", "RetroArch", "PKGj", "VitaDB",
        "SaveManager", "BatteryMgr", "FTP Client", "Theme Manager",
        "Cheat Device", "Music Player", "File Browser"
    };
    const char* authors[] = {
        "TheFloW", "TheFloW", "Libretro", "blastrock", "devnoname120",
        "Team", "Team", "Team", "Team", "Team", "Team", "Team"
    };
    for (int i = 0; i < 12; ++i) {
        CatalogItem it;
        it.id = std::string("mock_") + std::to_string(i);
        it.name = names[i];
        it.author = authors[i];
        it.status = (i % 5 == 0) ? "Legacy" : "Verified";
        it.version = "1.0";
        items_.push_back(it);
    }
    state_.focusIndex = 0;
    state_.scrollRow = 0;
}

int FullCatalogScreen::totalRows() const {
    if (items_.empty()) return 0;
    return (static_cast<int>(items_.size()) + GRID_COLS - 1) / GRID_COLS;
}

int FullCatalogScreen::visibleRows() const {
    const int gridTop = HEADER_H + TABS_H + GRID_PAD;
    const int gridBottom = SCREEN_H - FOOTER_H - GRID_PAD;
    const int gridH = gridBottom - gridTop;
    const int cardH = 120;
    int rows = gridH / (cardH + CARD_GAP);
    return rows > 0 ? rows : 1;
}

void FullCatalogScreen::clampFocus() {
    if (items_.empty()) {
        state_.focusIndex = 0;
        state_.scrollRow = 0;
        return;
    }
    if (state_.focusIndex < 0) state_.focusIndex = 0;
    if (state_.focusIndex >= static_cast<int>(items_.size())) {
        state_.focusIndex = static_cast<int>(items_.size()) - 1;
    }

    const int focusRow = state_.focusIndex / GRID_COLS;
    const int vis = visibleRows();
    if (focusRow < state_.scrollRow) {
        state_.scrollRow = focusRow;
    } else if (focusRow >= state_.scrollRow + vis) {
        state_.scrollRow = focusRow - vis + 1;
    }
    if (state_.scrollRow < 0) state_.scrollRow = 0;
    const int maxScroll = std::max(0, totalRows() - vis);
    if (state_.scrollRow > maxScroll) state_.scrollRow = maxScroll;
}

void FullCatalogScreen::handleInput() {
    SceCtrlData pad;
    std::memset(&pad, 0, sizeof(pad));
    sceCtrlPeekBufferPositive(0, &pad, 1);

    static uint32_t prev = 0;
    uint32_t pressed = pad.buttons & ~prev;
    prev = pad.buttons;

    if (pressed & SCE_CTRL_LEFT) {
        if (state_.focusIndex % GRID_COLS > 0) state_.focusIndex--;
    }
    if (pressed & SCE_CTRL_RIGHT) {
        if (state_.focusIndex % GRID_COLS < GRID_COLS - 1 &&
            state_.focusIndex + 1 < static_cast<int>(items_.size())) {
            state_.focusIndex++;
        }
    }
    if (pressed & SCE_CTRL_UP) {
        if (state_.focusIndex - GRID_COLS >= 0) state_.focusIndex -= GRID_COLS;
    }
    if (pressed & SCE_CTRL_DOWN) {
        if (state_.focusIndex + GRID_COLS < static_cast<int>(items_.size())) {
            state_.focusIndex += GRID_COLS;
        }
    }
    if (pressed & SCE_CTRL_LTRIGGER) {
        int c = static_cast<int>(state_.catalog) - 1;
        if (c < 0) c = static_cast<int>(CatalogType::Count) - 1;
        state_.catalog = static_cast<CatalogType>(c);
        state_.focusIndex = 0;
        state_.scrollRow = 0;
        // Mock: same list for now; later swap data source
    }
    if (pressed & SCE_CTRL_RTRIGGER) {
        int c = static_cast<int>(state_.catalog) + 1;
        if (c >= static_cast<int>(CatalogType::Count)) c = 0;
        state_.catalog = static_cast<CatalogType>(c);
        state_.focusIndex = 0;
        state_.scrollRow = 0;
    }
    if (pressed & SCE_CTRL_CROSS) {
        if (!items_.empty()) {
            sceClibPrintf("[UI] select %s (%s)\n",
                          items_[state_.focusIndex].name.c_str(),
                          catalogName(state_.catalog));
        }
    }
    if (pressed & SCE_CTRL_START) {
        state_.requestExit = true;
    }

    clampFocus();
}

void FullCatalogScreen::draw() {
    vita2d_start_drawing();
    vita2d_clear_screen();

    // Header
    vita2d_draw_rectangle(0, 0, SCREEN_W, HEADER_H, SURFACE2);
    vita2d_pgf_draw_text(font_, 16, 32, ACCENT, 1.2f, "PSVitaAlive");
    vita2d_pgf_draw_text(font_, SCREEN_W - 120, 32, TEXT_DIM, 1.0f, "START: exit");

    // Tabs
    vita2d_draw_rectangle(0, HEADER_H, SCREEN_W, TABS_H, SURFACE);
    const float tabW = static_cast<float>(SCREEN_W) / static_cast<int>(CatalogType::Count);
    for (int i = 0; i < static_cast<int>(CatalogType::Count); ++i) {
        float x = i * tabW;
        bool active = (static_cast<int>(state_.catalog) == i);
        if (active) {
            vita2d_draw_rectangle(static_cast<int>(x), HEADER_H + TABS_H - 3,
                                  static_cast<int>(tabW), 3, ACCENT);
        }
        vita2d_pgf_draw_text(font_,
                             static_cast<int>(x + 12),
                             HEADER_H + 24,
                             active ? ACCENT : TEXT,
                             1.0f,
                             catalogName(static_cast<CatalogType>(i)));
    }

    // Grid
    const int gridTop = HEADER_H + TABS_H + GRID_PAD;
    const int gridBottom = SCREEN_H - FOOTER_H - GRID_PAD;
    const int gridH = gridBottom - gridTop;
    const int cardH = 120;
    const int usableW = SCREEN_W - GRID_PAD * 2 - CARD_GAP * (GRID_COLS - 1);
    const int cardW = usableW / GRID_COLS;
    const int vis = visibleRows();

    for (int row = 0; row < vis; ++row) {
        int realRow = state_.scrollRow + row;
        for (int col = 0; col < GRID_COLS; ++col) {
            int idx = realRow * GRID_COLS + col;
            if (idx < 0 || idx >= static_cast<int>(items_.size())) continue;

            int x = GRID_PAD + col * (cardW + CARD_GAP);
            int y = gridTop + row * (cardH + CARD_GAP);
            bool focused = (idx == state_.focusIndex);

            vita2d_draw_rectangle(x, y, cardW, cardH, SURFACE);
            if (focused) {
                // accent border
                vita2d_draw_rectangle(x, y, cardW, 3, ACCENT);
                vita2d_draw_rectangle(x, y + cardH - 3, cardW, 3, ACCENT);
                vita2d_draw_rectangle(x, y, 3, cardH, ACCENT);
                vita2d_draw_rectangle(x + cardW - 3, y, 3, cardH, ACCENT);
            } else {
                vita2d_draw_rectangle(x, y, cardW, 1, BORDER);
            }

            // Icon placeholder
            vita2d_draw_rectangle(x + 10, y + 10, 64, 64, SURFACE2);

            const auto& it = items_[idx];
            vita2d_pgf_draw_text(font_, x + 84, y + 28, WHITE, 1.0f, it.name.c_str());
            vita2d_pgf_draw_text(font_, x + 84, y + 50, TEXT, 0.9f, it.author.c_str());

            unsigned stColor = (it.status == "Verified") ? ACCENT : TEXT_DIM;
            vita2d_pgf_draw_text(font_, x + 84, y + 72, stColor, 0.9f, it.status.c_str());
            vita2d_pgf_draw_text(font_, x + 10, y + 100, TEXT_DIM, 0.85f, it.version.c_str());
        }
    }

    // Footer hints
    vita2d_draw_rectangle(0, SCREEN_H - FOOTER_H, SCREEN_W, FOOTER_H, SURFACE2);
    vita2d_pgf_draw_text(
        font_, 12, SCREEN_H - 14, TEXT, 0.9f,
        "D-Pad: move   X: select   L/R: catalog   START: exit"
    );

    vita2d_end_drawing();
    vita2d_swap_buffers();
}

bool FullCatalogScreen::updateAndDraw() {
    if (!ready_) return false;
    handleInput();
    draw();
    return !state_.requestExit;
}

} // namespace ui
} // namespace psvitaalive
